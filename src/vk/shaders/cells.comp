#version 450
// The painter (src/vk/vk.h): a workgroup a listed 16 x 16 tile of the
// surface, each pixel its cell's background with the foreground over it
// by the glyph's coverage (past the last whole cell, the default
// background), with
// the images placed over it as kitty composites them: z < 0 under the
// glyph (below UNDER_BG only on a default background), z >= 0 over it,
// in z order, alpha blended, each scaled to its rect by area average.
// Integers only: the pixels are a pure function of the cells, the
// placements and the texels, so a test pins them against a host
// reference (tests/vk/vk_test.c)

layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer Tiles { uint tile[]; };
layout(set = 0, binding = 1) readonly buffer Cells { uint cell[]; };
// the glyph cache: a slot's coverage, a byte a pixel, four to a word
layout(set = 0, binding = 2) readonly buffer Atlas { uint atlas[]; };
layout(set = 0, binding = 3) writeonly buffer Surf { uint px[]; };
// x y w h, the texels' offset, their w h, z (src/vk/vk.c PLACE_WORDS)
layout(set = 0, binding = 4) readonly buffer Places { uint place[]; };
// RGBA bytes a word
layout(set = 0, binding = 5) readonly buffer Arena { uint tex[]; };
// id, offset, w h, the virtual placement's cols rows; a wipe's split
// column (NO_WIPE: none), its left image's offset, its marker's offset,
// w h (TAB_WORDS)
layout(set = 0, binding = 6) readonly buffer Tab { uint tab[]; };
layout(push_constant) uniform Push {
  uint surf_w;
  uint surf_h;
  uint gw;
  uint gh;
  uint cols;
  uint rows;
  uint bgra;
  uint def_fg; // CTUI_COLOR_DEFAULT's, a cell flagged so takes them
  uint def_bg; // and past the last whole cell
  uint nplace;
  uint ntab;
};

// CTUI_ATTR_* (core/cell.h)
const uint BOLD = 1u, DIM = 2u, UNDERLINE = 8u, STRIKE = 16u;
const uint FG_DEFAULT = 1u << 8, BG_DEFAULT = 1u << 9, PLACEHOLDER = 1u << 10;
const uint BOX = 0xffffu;
const uint NO_WIPE = 0xffffffffu;
const uint TAB = 12u;
const int UNDER_BG = -1073741824; // CTUI_GFX_KITTY_Z_UNDER_BG
// the most texels a side one pixel averages: a bigger shrink skips
const uint AREA_MAX = 16u;

// an image's (off, iw x ih) texel at (dx, dy) of it drawn pw x ph, as
// RGBA (rgb << 8 | a), its footprint averaged
uint area(uint off, uint iw, uint ih, uint dx, uint dy, uint pw, uint ph) {
  uint sx0 = dx * iw / pw, sy0 = dy * ih / ph;
  uint sx1 = max(sx0 + 1u, (dx + 1u) * iw / pw);
  uint sy1 = max(sy0 + 1u, (dy + 1u) * ih / ph);
  uint stx = max(1u, (sx1 - sx0 + AREA_MAX - 1u) / AREA_MAX);
  uint sty = max(1u, (sy1 - sy0 + AREA_MAX - 1u) / AREA_MAX);
  uint r = 0u, g = 0u, bl = 0u, a = 0u, n = 0u;
  for (uint sy = sy0; sy < sy1; sy += sty)
    for (uint sx = sx0; sx < sx1; sx += stx) {
      uint t = tex[off + sy * iw + sx];
      r += t & 0xffu;
      g += t >> 8 & 0xffu;
      bl += t >> 16 & 0xffu;
      a += t >> 24;
      n++;
    }
  return (r / n) << 24 | (g / n) << 16 | (bl / n) << 8 | a / n;
}

// placement p's texel at pixel (x, y); alpha 0 outside it
uint texel(uint p, uint x, uint y) {
  uint b = p * 8u;
  uint px0 = place[b], py0 = place[b + 1u], pw = place[b + 2u], ph = place[b + 3u];
  if (x < px0 || y < py0 || x >= px0 + pw || y >= py0 + ph)
    return 0u;
  return area(place[b + 4u], place[b + 5u], place[b + 6u], x - px0, y - py0,
                pw, ph);
}

// a placeholder cell's texel: image id's, at (dx, dy) of its virtual
// placement, the image fit into it with its aspect kept, centred (kitty's
// graphics.c); alpha 0 where it doesn't reach or there's no such image
uint placeholder(uint id, uint dx, uint dy) {
  for (uint i = 0u; i < ntab; i++) {
    uint b = i * TAB;
    if (tab[b] != id)
      continue;
    uint iw = tab[b + 2u], ih = tab[b + 3u];
    uint pw = tab[b + 4u] * gw, ph = tab[b + 5u] * gh;
    if (iw == 0u || pw == 0u || ph == 0u)
      return 0u;
    uint dw = pw, dh = ph;
    if (iw * ph > ih * pw)
      dh = max(1u, ih * pw / iw);
    else
      dw = max(1u, iw * ph / ih);
    uint ox = (pw - dw) / 2u, oy = (ph - dh) / 2u;
    if (dx < ox || dy < oy || dx >= ox + dw || dy >= oy + dh)
      return 0u;
    uint ex = dx - ox, ey = dy - oy, split = tab[b + 6u];
    if (split == NO_WIPE)
      return area(tab[b + 1u], iw, ih, ex, ey, dw, dh);
    // a wipe: left of the split from the left image, the marker (its
    // texels at the image's scale, nearest) over it where it has alpha
    uint sx = ex * iw / dw;
    uint t = area(sx < split ? tab[b + 7u] : tab[b + 1u], iw, ih, ex, ey, dw, dh);
    uint mw = tab[b + 9u], mh = tab[b + 10u];
    int mx = int(sx) - (int(split) - int(mw / 2u));
    if (mw != 0u && mx >= 0 && mx < int(mw)) {
      uint m = tex[tab[b + 8u] + (ey * ih / dh) * mh / ih * mw + uint(mx)];
      if ((m >> 24) != 0u)
        t = (m & 0xffu) << 24 | (m >> 8 & 0xffu) << 16 | (m >> 16 & 0xffu) << 8 | m >> 24;
    }
    return t;
  }
  return 0u;
}

// glyph slot g's coverage at (gx, gy)
uint coverage(uint g, uint gx, uint gy) {
  uint i = g * ((gw * gh + 3u) / 4u) * 4u + gy * gw + gx;
  return atlas[i >> 2] >> (8u * (i & 3u)) & 0xffu;
}

// fg over bg (0xRRGGBB) by c of 255
uint blend(uint bg, uint fg, uint c) {
  uint o = 0u;
  for (uint s = 0u; s < 24u; s += 8u)
    o |= (((fg >> s & 0xffu) * c + (bg >> s & 0xffu) * (255u - c) + 127u) / 255u) << s;
  return o;
}

// t (rgb << 8 | a) over dst (0xRRGGBB)
uint over(uint dst, uint t) {
  uint a = t & 0xffu;
  if (a == 0u)
    return dst;
  uint src = t >> 8;
  if (a == 255u)
    return src;
  uint o = 0u;
  for (uint s = 0u; s < 24u; s += 8u) {
    uint c = ((src >> s & 0xffu) * a + (dst >> s & 0xffu) * (255u - a) + 127u) / 255u;
    o |= c << s;
  }
  return o;
}

uint word(uint rgb) {
  uint r = rgb >> 16 & 0xffu, g = rgb >> 8 & 0xffu, b = rgb & 0xffu;
  return (bgra != 0u ? b | r << 16 : r | b << 16) | g << 8 | 0xff000000u;
}

void main() {
  uint t = tile[gl_WorkGroupID.x];
  uint x = (t & 0xffffu) * 16u + gl_LocalInvocationID.x;
  uint y = (t >> 16) * 16u + gl_LocalInvocationID.y;
  if (x >= surf_w || y >= surf_h)
    return;
  uint cx = x / gw, cy = y / gh, rgb = def_bg;
  uint cov = 0u;
  bool bg_default = true;
  uint ph = 0u; // a placeholder cell's image, where the glyph would be
  uint fg = def_fg;
  if (cx < cols && cy < rows) {
    uint i = (cy * cols + cx) * 3u;
    uint g = cell[i] & 0xffffu, a = cell[i] >> 16;
    fg = (a & FG_DEFAULT) != 0u ? def_fg : cell[i + 1u];
    uint bg = (a & BG_DEFAULT) != 0u ? def_bg : cell[i + 2u];
    bg_default = (a & BG_DEFAULT) != 0u;
    uint gx = x % gw, gy = y % gh;
    if ((a & PLACEHOLDER) != 0u) {
      // the image is the cell's content: a z 0 placement, over the
      // ones under text, under the ones over it
      // g its column, the attrs' byte its row
      ph = placeholder(cell[i + 1u], g * gw + gx, (a & 0xffu) * gh + gy);
      a = a & (FG_DEFAULT | BG_DEFAULT | PLACEHOLDER);
    } else if (g == BOX) {
      cov = gx == 0u || gx == gw - 1u || gy == gh / 8u || gy == gh - 1u - gh / 8u ? 255u : 0u;
    } else {
      cov = coverage(g, gx, gy);
      // bold: the glyph smeared a pixel right
      if ((a & BOLD) != 0u && gx > 0u)
        cov = max(cov, coverage(g, gx - 1u, gy));
    }
    if ((a & UNDERLINE) != 0u && gy == gh - 1u - gh / 16u)
      cov = 255u;
    if ((a & STRIKE) != 0u && gy == gh / 2u)
      cov = 255u;
    if ((a & DIM) != 0u)
      fg = ((fg & 0xfefefeu) >> 1) + ((bg & 0xfefefeu) >> 1);
    rgb = bg;
  }
  uint p = 0u;
  for (; p < nplace && int(place[p * 8u + 7u]) < 0; p++)
    if (int(place[p * 8u + 7u]) >= UNDER_BG || bg_default)
      rgb = over(rgb, texel(p, x, y));
  rgb = blend(rgb, fg, cov);
  rgb = over(rgb, ph);
  for (; p < nplace; p++)
    rgb = over(rgb, texel(p, x, y));
  px[y * surf_w + x] = word(rgb);
}
